;
; BtA2dpL2cap.inf - L2CAP proxy profile driver for a single Bluetooth A2DP sink (BtA2dpSrc project).
;
; IMPORTANT: The hardware ID below is the same one Microsoft's in-box BthA2dp uses. This package is
; never selected automatically for a device that already has a driver of equal/better rank; it is
; applied per device by scripts\switch-device-driver.ps1 (explicit, reversible). Installing this
; driver on a device REMOVES the in-box Windows audio endpoint for that headset (by design: audio is
; delivered by the BtA2dpSrc service instead).
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderName%
CatalogFile = BtA2dpL2cap.cat
; Deliberately old date: if this package is present in the driver store, the in-box driver wins the
; rank tie for newly paired headsets, so nothing is switched without the explicit switcher.
DriverVer   = 01/01/2006,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
BtA2dpL2cap.sys = 1,,

[Manufacturer]
%ProviderName% = Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceDesc% = BtA2dpL2cap_Install, BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}

[BtA2dpL2cap_Install.NT]
CopyFiles = BtA2dpL2cap_CopyFiles

[BtA2dpL2cap_CopyFiles]
BtA2dpL2cap.sys

[BtA2dpL2cap_Install.NT.HW]
AddReg = BtA2dpL2cap_Security

[BtA2dpL2cap_Security]
; Only SYSTEM (the BtA2dpSrc service) and Administrators may open the device.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[BtA2dpL2cap_Install.NT.Services]
AddService = BtA2dpL2cap, 0x00000002, BtA2dpL2cap_Service

[BtA2dpL2cap_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\BtA2dpL2cap.sys

[BtA2dpL2cap_Install.NT.Wdf]
KmdfService = BtA2dpL2cap, BtA2dpL2cap_WdfSect

[BtA2dpL2cap_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "BtA2dpSrc Project"
DiskName     = "BtA2dpSrc Driver Disk"
DeviceDesc   = "BtA2dpSrc A2DP Sink Link (L2CAP proxy)"
ServiceDesc  = "BtA2dpSrc L2CAP proxy"
